{
  "name": "little-archer-monster-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "art:openai": "NODE_USE_ENV_PROXY=1 tsx scripts/art/openai.ts",
    "art:cut": "tsx scripts/art/cut.ts",
    "art:cut:rr": "tsx scripts/art/cut.ts --set rr"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "sharp": "0.34.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
