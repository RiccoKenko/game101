{
  "name": "little-archer-sky-pirates",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "art": "tsx scripts/art/slice.ts",
    "art:publish": "tsx scripts/art/publish.ts",
    "map:sketch": "tsx scripts/art/map-sketch.ts",
    "map:chapter": "tsx scripts/art/chapter-sketch.ts",
    "art:gemini": "tsx scripts/art/gemini.ts",
    "showcase:artifact": "node scripts/build-showcase.mjs",
    "play:artifact": "node scripts/build-showcase.mjs sky-pirates-play.html play"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/three": "0.185.4",
    "sharp": "0.34.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
